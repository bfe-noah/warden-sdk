+/*
+ * RV1106 uses the same SBPI-protocol OTP controller as the rk3568/rk3588
+ * family (the vendor 5.10 driver selected rk3568_otp_read, which is the same
+ * SBPI sequence as mainline's rk3588_otp_read). Six clocks, matching the DT
+ * clock-names usr/sbpi/apb/phy/arb/pmc. 0x80 bytes of user OTP.
+ */
+static const char * const rv1106_otp_clocks[] = {
+	"usr", "sbpi", "apb", "phy", "arb", "pmc",
+};
+
+static const struct rockchip_data rv1106_data = {
+	.size = 0x80,
+	.clks = rv1106_otp_clocks,
+	.num_clks = ARRAY_SIZE(rv1106_otp_clocks),
+	/*
+	 * User-mode OTPC_USER read (rockchip_otp_reset -> ecc_enable ->
+	 * per-byte FSM), same sequence the vendor 5.10 driver used for
+	 * rv1106 (its rk3568_otp_read). rk3588_otp_read uses a different
+	 * addressing path and times out on this controller.
+	 */
+	.reg_read = px30_otp_read,
+};
+
 static const struct of_device_id rockchip_otp_match[] = {
 	{
 		.compatible = "rockchip,px30-otp",
@@ -311,6 +334,10 @@ static const struct of_device_id rockchip_otp_match[] = {
 		.compatible = "rockchip,rk3588-otp",
 		.data = &rk3588_data,
 	},
+	{
+		.compatible = "rockchip,rv1106-otp",
