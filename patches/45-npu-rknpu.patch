diff --git a/drivers/rknpu/Kconfig b/drivers/rknpu/Kconfig
new file mode 100644
index 000000000..29007caac
--- /dev/null
+++ b/drivers/rknpu/Kconfig
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# RKNPU -- Rockchip NPU (rknpu) kernel driver, forward-ported from the
+# vendor 5.10.160 RV1106 BSP (drivers/rknpu/, v0.9.2) to 6.18.
+# See warden-sdk/kernel/rv1106-enablement/npu/PORT-PLAN.md for the full
+# port plan and warden-sdk/kernel/rv1106-enablement/npu/PORT-PROGRESS.md
+# for what was actually done.
+#
+# Trimmed vs the vendor Kconfig: no ROCKCHIP_RKNPU_SRAM/FENCE/DMA_HEAP
+# choice here -- RV1106 needs none of them (single-core NPU, no NBUF, no
+# multi-domain fencing; DRM_GEM is the only memory manager wired in).
+
+menu "RKNPU"
+	depends on ARCH_ROCKCHIP
+
+config ROCKCHIP_RKNPU
+	tristate "Rockchip RKNPU support"
+	depends on DRM
+	help
+	  Kernel-mode driver for the Rockchip NPU (RKNPU) found on RV1106
+	  and other Rockchip SoCs. Registers a DRM device (/dev/dri/cardN)
+	  and implements power/clock/reset sequencing, GEM buffer
+	  management, and the regcmd task-queue submit ioctl. Does not
+	  include a compiler/runtime capable of producing regcmd programs
+	  for the NPU to execute -- that piece is closed-source Rockchip
+	  userspace (RKNN-Toolkit2 / librknnrt) and is not shipped by this
+	  port. See npu/OPEN-NPU-PLAN.md for what this does and does not
+	  unlock.
+
+if ROCKCHIP_RKNPU
+
+config ROCKCHIP_RKNPU_DEBUG_FS
+	bool "RKNPU debugfs"
+	depends on DEBUG_FS
+	default y
+	help
+	  Enable debugfs to debug RKNPU usage.
+
+config ROCKCHIP_RKNPU_PROC_FS
+	bool "RKNPU procfs"
+	depends on PROC_FS
+	default y
+	help
+	  Enable /proc/rknpu/load (the Monitor page's continuity target --
+	  see npu/PORT-PLAN.md §2.1).
+
+config ROCKCHIP_RKNPU_DRM_GEM
+	bool "RKNPU DRM GEM"
+	depends on DRM
+	default y
+	help
+	  RKNPU memory manager backed by DRM GEM (/dev/dri/cardN,
+	  DRM_IOCTL_RKNPU_*). The only memory manager this port wires up --
+	  the vendor's alternative DMA_HEAP path is not ported (see
+	  npu/PORT-PLAN.md §2.1/§2.2).
+
+endif
+
+endmenu
diff --git a/drivers/rknpu/Makefile b/drivers/rknpu/Makefile
new file mode 100644
index 000000000..687cbb5fc
--- /dev/null
+++ b/drivers/rknpu/Makefile
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_ROCKCHIP_RKNPU) += rknpu.o
+
+# compat/ goes FIRST so our stub soc/rockchip/rockchip_{iommu,opp_select,
+# system_monitor,ipa}.h shadow anything a future in-tree header of the same
+# name might introduce (see PORT-PLAN.md §2.4 -- rockchip_iommu.h in
+# particular must not resolve to this tree's real, unrelated
+# CONFIG_ROCKCHIP_IOMMU driver headers).
+ccflags-y += -I$(srctree)/$(src)/compat
+ccflags-y += -I$(srctree)/$(src)/include
+ccflags-y += -I$(src)/include
+ccflags-y += -Werror
+
+rknpu-y += rknpu_drv.o
+rknpu-y += rknpu_reset.o
+rknpu-y += rknpu_job.o
+rknpu-y += rknpu_debugger.o
+rknpu-y += rknpu_iommu.o
+rknpu-$(CONFIG_ROCKCHIP_RKNPU_DRM_GEM) += rknpu_gem.o
diff --git a/drivers/rknpu/compat/soc/rockchip/rockchip_iommu.h b/drivers/rknpu/compat/soc/rockchip/rockchip_iommu.h
new file mode 100644
index 000000000..d829ecd31
--- /dev/null
+++ b/drivers/rknpu/compat/soc/rockchip/rockchip_iommu.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Compat shim for the vendor-BSP-only <soc/rockchip/rockchip_iommu.h>
+ * convenience wrapper, absent from mainline (PORT-PLAN.md §2.4).
+ *
+ * NOT a copy of the vendor header's own #if IS_ENABLED(CONFIG_ROCKCHIP_IOMMU)
+ * gate: this 6.18 tree already has a *real*, unrelated CONFIG_ROCKCHIP_IOMMU
+ * (drivers/iommu/rockchip-iommu.c, the mainline IOMMU driver, =y in our
+ * .config for the display/VOP2 path) that does not implement this vendor
+ * convenience API at all. Gating on that symbol here would silently select
+ * extern declarations with no definition anywhere -> link failure. So this
+ * shim is unconditional, independent of CONFIG_ROCKCHIP_IOMMU.
+ *
+ * rknpu_drv.c's only call site (rknpu_power_off(), guarded by
+ * `if (rknpu_dev->multiple_domains)`) is dead code for RV1106: the board DT
+ * carries no `iommus =` property and rv1106_rknpu_config never sets
+ * multiple_domains (that's an RK3588 3-core-NPU-only path). Stub returns
+ * false, matching the vendor's own "IOMMU disabled" default.
+ */
+#ifndef __SOC_ROCKCHIP_IOMMU_H
+#define __SOC_ROCKCHIP_IOMMU_H
+
+struct device;
+
+static inline bool rockchip_iommu_is_enabled(struct device *dev)
+{
+	return false;
+}
+
+#endif
diff --git a/drivers/rknpu/compat/soc/rockchip/rockchip_ipa.h b/drivers/rknpu/compat/soc/rockchip/rockchip_ipa.h
new file mode 100644
index 000000000..074da2ebc
--- /dev/null
+++ b/drivers/rknpu/compat/soc/rockchip/rockchip_ipa.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2018 Fuzhou Rockchip Electronics Co., Ltd
+ *
+ * 6.18 port compat-shim note (PORT-PLAN.md §2.4): copied verbatim from the
+ * vendor 5.10 BSP. CONFIG_ROCKCHIP_IPA does not exist anywhere in
+ * mainline, so `#if IS_ENABLED(CONFIG_ROCKCHIP_IPA)` below always
+ * evaluates false and the static-inline stub branch is always selected
+ * (rockchip_ipa_power_model_init() returns ERR_PTR(-ENOTSUPP)).
+ */
+#ifndef __SOC_ROCKCHIP_IPA_H
+#define __SOC_ROCKCHIP_IPA_H
+
+struct ipa_power_model_data {
+	u32 static_coefficient;
+	u32 dynamic_coefficient;
+	s32 ts[4];			/* temperature scaling factor */
+	struct thermal_zone_device *tz;
+	u32 leakage;
+	u32 ref_leakage;
+	u32 lkg_range[2];		/* min leakage and max leakage */
+	s32 ls[3];			/* leakage scaling factor */
+};
+
+#if IS_ENABLED(CONFIG_ROCKCHIP_IPA)
+struct ipa_power_model_data *rockchip_ipa_power_model_init(struct device *dev,
+							   char *lkg_name);
+unsigned long
+rockchip_ipa_get_static_power(struct ipa_power_model_data *model_data,
+			      unsigned long voltage_mv);
+#else
+static inline struct ipa_power_model_data *
+rockchip_ipa_power_model_init(struct device *dev, char *lkg_name)
+{
+	return ERR_PTR(-ENOTSUPP);
+};
+
+static inline unsigned long
+rockchip_ipa_get_static_power(struct ipa_power_model_data *data,
+			      unsigned long voltage_mv)
+{
+	return 0;
+}
+#endif /* CONFIG_ROCKCHIP_IPA */
+
+#endif
